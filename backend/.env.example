# ── Database ──────────────────────────────────
# Get this from Neon (neon.tech) or Supabase (supabase.com):
# 1. Sign up / log in
# 2. Create a new project
# 3. Copy the "connection string" (usually under Settings > Database)
# 4. Paste it below, replacing the placeholder
DATABASE_URL="gresql://user:password@host:5432/dbname?sslmode=require"

# ── Auth ──────────────────────────────────────
# Any long random string — used to sign JWT tokens.
# Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── M-Pesa Daraja API (Phase: Payments) ──────
# From https://developer.safaricom.co.ke/ — Sandbox credentials first, then Production
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_ENV="sandbox"
